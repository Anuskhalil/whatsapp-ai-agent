APP_NAME=NexusAI
APP_VERSION=1.0.0
ENVIRONMENT=development

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_WRITE_TIMEOUT_SECONDS=30
OLLAMA_POOL_TIMEOUT_SECONDS=10
OLLAMA_MAX_TOOL_ROUNDS=5

TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_MAX_RESULTS=3
TAVILY_SNIPPET_CHARACTERS=700

OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

EXTERNAL_HTTP_CONNECT_TIMEOUT_SECONDS=10
EXTERNAL_HTTP_READ_TIMEOUT_SECONDS=30
EXTERNAL_HTTP_WRITE_TIMEOUT_SECONDS=15
EXTERNAL_HTTP_POOL_TIMEOUT_SECONDS=10

EXTERNAL_HTTP_MAX_ATTEMPTS=3
EXTERNAL_HTTP_BASE_DELAY_SECONDS=0.5
EXTERNAL_HTTP_MAX_DELAY_SECONDS=2

MAX_HISTORY_MESSAGES=20
MEMORY_LLM_TIMEOUT_SECONDS=20

SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_BATCH_SIZE=8
SUMMARY_LLM_TIMEOUT_SECONDS=30

MAX_MESSAGE_CHARACTERS=4000

API_RATE_LIMIT_REQUESTS=10
API_RATE_LIMIT_WINDOW_SECONDS=60

WHATSAPP_RATE_LIMIT_REQUESTS=8
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=3

APP_HOST=0.0.0.0
APP_PORT=8000

OLLAMA_HEALTH_URL=http://localhost:11434/api/tags
OLLAMA_HEALTH_TIMEOUT_SECONDS=5

PUBLIC_BASE_URL=
VERIFY_TWILIO_SIGNATURE=false

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_OUTBOUND_ENABLED=false
TWILIO_MAX_OUTBOUND_CHARACTERS=1500

WHATSAPP_JOB_POLL_SECONDS=1
WHATSAPP_JOB_MAX_ATTEMPTS=3
WHATSAPP_JOB_RETRY_DELAY_SECONDS=5
WHATSAPP_WORKER_SHUTDOWN_TIMEOUT_SECONDS=10

# =========================================
# API SECURITY
# =========================================

ASK_API_KEY=CHANGE_ME